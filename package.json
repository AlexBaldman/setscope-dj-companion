{
  "name": "setscope-dj-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server.mjs",
    "bundle:pitch": "esbuild node_modules/pitchy/index.js --bundle --format=esm --platform=browser --minify --outfile=src/vendor/pitchy.js",
    "build:pages": "node scripts/build-pages.mjs",
    "check": "node scripts/check-source.mjs && node scripts/check.mjs && node scripts/run-unit-tests.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs && npm run build:pages && node scripts/pages-runtime.browser.test.mjs",
    "test:pages": "npm run build:pages && node scripts/pages-runtime.browser.test.mjs",
    "canary": "node scripts/deployment-canary.mjs"
  },
  "dependencies": {
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1"
  }
}
